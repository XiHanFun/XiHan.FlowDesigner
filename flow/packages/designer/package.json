{
  "name": "@xihan-flow/designer",
  "type": "module",
  "version": "0.0.0",
  "description": "XiHan Flow Designer — a visual flow designer delivered as Web Components.",
  "author": {
    "name": "XiHanFun",
    "url": "https://github.com/XiHanFun"
  },
  "license": "MIT",
  "homepage": "https://github.com/XiHanFun/XiHan.FlowDesigner#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XiHanFun/XiHan.FlowDesigner.git",
    "directory": "flow/packages/designer"
  },
  "bugs": {
    "url": "https://github.com/XiHanFun/XiHan.FlowDesigner/issues"
  },
  "keywords": [
    "flow",
    "flow-designer",
    "workflow",
    "diagram",
    "web-components",
    "xihanfun"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./style.css"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "style.css"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@xihan-flow/core": "workspace:^",
    "@xihan-flow/runtime": "workspace:^",
    "@xihan-ui/core": "catalog:",
    "@xihan-ui/designer-kit": "catalog:",
    "@xihan-ui/designer-shell": "catalog:",
    "@xihan-ui/pointer": "catalog:",
    "@xihan-ui/viz": "catalog:",
    "@xihan-ui/web-components": "catalog:"
  }
}
