{
  "name": "@xihan-flow/core",
  "type": "module",
  "version": "0.0.0",
  "description": "XiHan Flow Designer core — flow graph schema, validation, layout and edit commands; pure TypeScript, no DOM.",
  "author": {
    "name": "XiHanFun",
    "url": "https://github.com/XiHanFun"
  },
  "license": "MIT",
  "homepage": "https://github.com/XiHanFun/XiHan.FlowDesigner#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XiHanFun/XiHan.FlowDesigner.git",
    "directory": "flow/packages/core"
  },
  "bugs": {
    "url": "https://github.com/XiHanFun/XiHan.FlowDesigner/issues"
  },
  "keywords": [
    "flow",
    "flow-designer",
    "workflow",
    "diagram",
    "web-components",
