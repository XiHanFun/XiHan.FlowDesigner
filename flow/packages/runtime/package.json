{
  "name": "@xihan-flow/runtime",
  "type": "module",
  "version": "1.0.0-rc.2",
  "description": "XiHan Flow Designer runtime — Web Components for viewing flow graphs and their run state.",
  "author": {
    "name": "XiHanFun",
    "url": "https://github.com/XiHanFun"
  },
  "license": "MIT",
  "homepage": "https://github.com/XiHanFun/XiHan.FlowDesigner#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XiHanFun/XiHan.FlowDesigner.git",
    "directory": "flow/packages/runtime"
  },
  "bugs": {
    "url": "https://github.com/XiHanFun/XiHan.FlowDesigner/issues"
  },
  "keywords": [
    "flow",
    "flow-designer",
    "workflow",
    "diagram",
    "web-components",
    "xihanfun"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./locale": {
      "types": "./dist/locale.d.ts",
      "import": "./dist/locale.js"
    },
    "./style.css": "./style.css"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "style.css"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "@xihan-ui/core": "^5.1.0",
    "@xihan-ui/designer-kit": "^5.1.0",
    "@xihan-ui/designer-shell": "^5.1.0",
    "@xihan-ui/pointer": "^5.1.0",
    "@xihan-ui/viz": "^5.1.0",
    "@xihan-ui/web-components": "^5.1.0"
  },
  "dependencies": {
    "@xihan-flow/core": "workspace:^"
  },
  "devDependencies": {
    "@xihan-ui/core": "catalog:",
    "@xihan-ui/designer-kit": "catalog:",
    "@xihan-ui/designer-shell": "catalog:",
    "@xihan-ui/pointer": "catalog:",
    "@xihan-ui/viz": "catalog:",
    "@xihan-ui/web-components": "catalog:",
    "jsdom": "catalog:"
  }
}
